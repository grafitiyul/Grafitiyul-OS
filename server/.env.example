# Server configuration
PORT=4000

# PostgreSQL connection string
# Railway will inject this automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/grafitiyul_os?schema=public"

# ── Admin authentication ────────────────────────────────────────
#
# Admin credentials are stored in the AdminUser table (see Prisma
# schema). Until the first AdminUser row exists, the server runs in
# bootstrap mode: /admin is reachable, and POST /api/auth/setup
# accepts a one-time create-first-user request. Once the first
# active admin exists, /api/auth/setup is locked and admin routes
# require a session cookie.
#
# SESSION_SECRET is REQUIRED and must be at least 16 characters.
# Without it the auth endpoints return 500 "auth_misconfigured".
# Rotating it invalidates every existing admin session.
#
# (The old ADMIN_USERNAME / ADMIN_PASSWORD env vars are no longer
# read by the server — credentials live in the DB.)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# ── iCount payment links ("תשלום באייקאונט") ────────────────────
#
# Personal payment links are generated via paypage/generate_sale with
# legacy body auth (cid/user/pass) — the PROVEN shape that makes iCount
# prefill customer details. Without these vars the feature returns a
# clean "icount_not_configured" error (deploying without them is safe).
ICOUNT_CID=
ICOUNT_USER=
ICOUNT_PASS=
# The iCount paypage TEMPLATE the personal sale links are generated from
# (e.g. the VAT template id). Required for link generation.
ICOUNT_DEFAULT_PAYPAGE_ID=
# Optional overrides
# ICOUNT_API_BASE=https://api.icount.co.il/api/v3.php
# ICOUNT_MAX_PAYMENTS=10
# Document production ("הפק מסמך") — VAT rate used to derive before-VAT totals
# for display + the ITA allocation-number threshold (₪ before VAT at/above
# which a tax invoice requires the customer's ח.פ/ע.מ). Defaults: 18 / 5000.
# ICOUNT_VAT_RATE=18
# ICOUNT_ALLOCATION_THRESHOLD_ILS=5000

# IPN (webhook) — optional but recommended. When BOTH ICOUNT_WEBHOOK_SECRET
# and PUBLIC_ORIGIN are set, generated links carry an ipn_url; the receiver
# ONLY logs raw payloads (no state changes in this slice).
ICOUNT_WEBHOOK_SECRET=

# This server's public URL (no trailing slash), e.g.
#   https://app.grafitiyul.co.il
# It is the SINGLE source for every customer-/user-facing absolute URL the
# server generates:
#   • permanent payment URLs      ${PUBLIC_ORIGIN}/pay/<token>
#   • iCount IPN webhook url       ${PUBLIC_ORIGIN}/api/webhooks/icount/<secret>
#   • Gmail OAuth callback         ${PUBLIC_ORIGIN}/api/email/connect/callback
#   • email open-tracking pixel    ${PUBLIC_ORIGIN}/api/track/email-open/<id>.gif
# Only stable tokens are stored in the DB, so moving to a custom domain updates
# every displayed/sent URL with NO migration. When unset, these fall back to the
# requesting host (fine locally; set it in production so links + the OAuth
# redirect are stable regardless of which host the request arrived on).
#
# IMPORTANT on cutover to a new domain:
#   1. Set this to the new origin (e.g. https://app.grafitiyul.co.il).
#   2. Add ${PUBLIC_ORIGIN}/api/email/connect/callback to the Google Cloud
#      OAuth client's Authorized redirect URIs — Gmail connect breaks otherwise.
#   3. Keep the OLD domain resolving (or 301 → new) during transition so payment
#      links, guide portal links, and tracking pixels ALREADY sent keep working.
PUBLIC_ORIGIN=

# ── Legacy-domain 301 redirect ──────────────────────────────────
#
# After the cutover, requests still arriving on the OLD Railway public host are
# permanently redirected to the same path+query on CANONICAL_ORIGIN, so links
# already in the wild (/pay/<token>, /p/<token>, tracking pixels, bookmarks)
# keep working. ONLY the exact LEGACY_PUBLIC_HOST matches — *.railway.internal
# (bridge↔server), the new domain, localhost and /health all pass through.
# Leave LEGACY_PUBLIC_HOST empty to disable the redirect. Defaults below match
# the current cutover, so unsetting these keeps the intended behavior.
CANONICAL_ORIGIN=https://app.grafitiyul.co.il
LEGACY_PUBLIC_HOST=grafitiyul-os-production.up.railway.app

# ── Email / Gmail integration ───────────────────────────────────
#
# Google OAuth (Workspace "Internal" app) + Gmail API. Without all three the
# email module stays dormant (accounts can't connect; the UI shows which vars
# are missing). Scopes are read-only + send — GOS never mutates the mailbox.
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — from the Google Cloud OAuth client
#     (Web application). Its Authorized redirect URI must be
#     ${PUBLIC_ORIGIN}/api/email/connect/callback (see PUBLIC_ORIGIN note above).
#   EMAIL_TOKEN_KEY — 16+ random chars; AES-256-GCM key for OAuth tokens at
#     rest. Rotating it forces every connected mailbox to reconnect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_TOKEN_KEY=

# ── Cloudflare R2 (private file storage) ────────────────────────
#
# Deal files, email attachments and WhatsApp media live in R2; downloads are
# short-lived presigned GETs, independent of PUBLIC_ORIGIN (they carry the R2
# endpoint, not this app's domain — the domain move does not affect them).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── WhatsApp bridges (one Railway service per number) ───────────
#
# accountId → bridge base URL over Railway's PRIVATE network
# (comma-separated key=url pairs). The accountId keys must match each
# bridge's WHATSAPP_ACCOUNT_ID env var.
# Example:
#   WHATSAPP_BRIDGE_URLS=main=http://gos-whatsapp-main.railway.internal:3000,office=http://gos-whatsapp-office.railway.internal:3000
WHATSAPP_BRIDGE_URLS=
# Shared secret for GOS → bridge calls. Must equal BRIDGE_INTERNAL_SECRET
# on every bridge service.
WHATSAPP_BRIDGE_SECRET=

# ── Ingress Platform (external lead / order sources) ─────────────
#
# NOTHING here is required to boot. An unconfigured source reports
# `configured:false` at startup and its endpoint answers 503 — the rest
# of GOS is unaffected. Check readiness at GET /api/ingress-admin/config.

# Global shadow mode: normalize, attribute and dedupe every event but
# write NO Contact/Deal. Use before a cutover to compare against the
# legacy automation safely. Off unless explicitly enabled.
INGRESS_DRY_RUN=
# Admin observability endpoints (default on).
INGRESS_ADMIN_ENABLED=

# Meta Lead Ads — endpoint: POST /api/ingress/meta
#   Meta Business Manager → app → verify X-Hub-Signature-256 with the app
#   secret; META_VERIFY_TOKEN is any value you also paste into Meta's
#   webhook setup; the Page access token fetches the lead's answers.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Optional hardening: restrict to one Page, and allow/block specific forms.
META_PAGE_ID=
META_ALLOWED_FORM_IDS=
META_BLOCKED_FORM_IDS=
META_GRAPH_VERSION=

# WooCommerce — endpoint: POST /api/ingress/woocommerce/:storeKey
#   storeKey is `primary` (existing site) or `secondary` (new site).
#   The primary store REUSES the existing WOOCOMMERCE_* credentials the
#   Woo sync module already uses — do not issue a second key for the same
#   store. Each store needs its own webhook secret.
WOO_PRIMARY_WEBHOOK_SECRET=
WOO_NEW_BASE_URL=
WOO_NEW_CONSUMER_KEY=
WOO_NEW_CONSUMER_SECRET=
WOO_NEW_WEBHOOK_SECRET=

# Website / Elementor forms — endpoint:
#   POST /api/ingress/website-form/<WEBSITE_FORM_SECRET>/<formKey>
#   formKey identifies the form (contact_page, footer, popup, product_page,
#   elementor_lp, …) and is what per-form attribution is keyed on.
WEBSITE_FORM_SECRET=

# ── Legacy Mirror (Intermediate Stabilization Phase) ─────────────────────────
# One-way only: Pipedrive → GOS and Airtable → GOS. Nothing in the mirror can
# write back to a legacy system. Governed by
# docs/architecture/GOS-source-ownership-map.md, which is a PRECONDITION: a
# field the map does not declare cannot be synchronized at all.
#
# MASTER SWITCH. Default OFF — the mirror writes to production CRM records, so
# it must never start by accident on a deploy. When false, webhooks are still
# RECEIVED durably (nothing is lost); only processing is paused, and the retry
# worker drains the backlog when it is switched on.
MIRROR_ENABLED=false

# Pipedrive webhook credentials. Create the subscription in Pipedrive
# (Tools → Webhooks) pointing at:
#   POST https://<host>/api/mirror/pipedrive
# with HTTP Basic auth; put the PASSWORD here. Without it the endpoint answers
# 503 and never accepts a payload.
MIRROR_PIPEDRIVE_WEBHOOK_SECRET=

# Poll interval for the backstop, in ms (minimum 30000, default 300000).
# Polling is not an optimisation of webhooks — it is the correctness guarantee.
# A missed or never-configured webhook is invisible without it, and Airtable has
# no delete signal worth trusting at all.
MIRROR_POLL_INTERVAL_MS=300000

# ── Source cutover registry ─────────────────────────────────────────────────
# Each external source moves from legacy to GOS INDIVIDUALLY. The invariant:
# NO SOURCE MAY HAVE TWO ACTIVE WRITERS.
#
#   legacy  the source still writes into Pipedrive/Airtable and reaches GOS via
#           the mirror; the GOS ingress endpoint for it is CLOSED (409).
#   direct  the source writes straight into GOS ingress; the mirror IGNORES it.
#   off     not connected.
#
# Default is `legacy` — forgetting a variable must never silently open a second
# writer. Setting `direct` WITHOUT the source's credentials is reported as a
# VIOLATION, not a warning: the legacy path is off, the direct path cannot
# receive, and leads would fall on the floor.
SOURCE_WRITER_META=legacy
SOURCE_WRITER_WOO_OLD=legacy
SOURCE_WRITER_WOO_NEW=legacy
SOURCE_WRITER_WEBSITE_FORMS=legacy

# ── WhatsApp bridge ─────────────────────────────────────────────────────────
# Stand-down switch for a retired number's bridge service. Unsetting
# WHATSAPP_ACCOUNT_ID does NOT stop a bridge — the Railway dispatcher would
# start that container as a second GOS SERVER. With BRIDGE_DISABLED=true the
# process boots, serves /health, and touches nothing: no socket, no account row,
# no database connection.
BRIDGE_DISABLED=false
